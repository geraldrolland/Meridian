KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=bucketnotifications
KAFKA_CONSUMER_GROUP_ID=meridian-video-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
DATABASE_URL=postgresql+asyncpg://postgres:postgres@video-db:5432/video_db
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=viduploads
MINIO_SECURE=false
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379
PROXY_SECRET=change-me-in-production
LOG_LEVEL=info
