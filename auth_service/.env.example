# Server
PORT=4000
HOST=127.0.0.1

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRY=7m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_MAX_AGE=604800000

# Proxy signature (shared secret with API gateway)
PROXY_SECRET=change-me-in-production

# Logging
LOG_LEVEL=info
